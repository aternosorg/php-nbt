{
  "name": "aternos/nbt",
  "description": "PHP library to parse, modify, and create NBT objects",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Kurt Thiemann",
      "email": "kurt@aternos.org"
    }
  ],
  "require": {
    "php": ">=8.4",
    "php-64bit": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-zlib": "*",
    "pocketmine/binaryutils": "^0.2.7"
  },
  "autoload": {
    "psr-4": {
      "Aternos\\Nbt\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload-dev": {
    "psr-4": {
      "Aternos\\Nbt\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
